# Copy to .env (never commit it) or export in your shell.
LLM_PROVIDER=anthropic            # anthropic | openai
LLM_MODEL=claude-haiku-5-5        # any model your key can use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: list prices (USD per 1M tokens) so reports show $ per 1k complaints.
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=
